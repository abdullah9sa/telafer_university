 "html": "<div class=\"print-format\" dir=\"rtl\">\n  <!-- header row -->\n  <table style=\"margin-bottom:16px;\">\n    <colgroup>\n      <col style=\"width:50%;\">\n      <col style=\"width:130px;\">\n      <col style=\"width:50%;\">\n    </colgroup>\n    <tr>\n      <td></td>\n      <td style=\"text-align:center; vertical-align:top;\">\n        <img id=\"qr-code\" src=\"{{ doc.qr_code }}\" alt=\"QR Code\" style=\"width:130px; height:130px;\">\n      </td>\n      <td style=\"text-align:right; vertical-align:top;\">\n        <h1 style=\"margin:0;\">\u062c\u0627\u0645\u0639\u0629 \u062a\u0644\u0639\u0641\u0631</h1>\n        <h2 style=\"margin:0;\">\u0646\u0638\u0627\u0645 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0637\u0644\u0627\u0628</h2>\n        <h2 class=\"ltr\" style=\"margin:0;\">{{ doc.name }}</h2>\n      </td>\n    </tr>\n  </table>\n\n  <!-- data table -->\n  <table class=\"table table-bordered\">\n    <tbody>\n      {% set excluded_fields = [\"Section Break\",\"Tab Break\",\"Column Break\",\"Attach\",\"Attach Image\",\"Image\",\"Table\"] %}\n      {% set fields = doc.meta.fields | rejectattr(\"fieldtype\",\"in\", excluded_fields) | list %}\n      {% for field in fields %}\n        {% set value = doc.get(field.fieldname) %}\n        {% if value and value not in [\"None\",\"none\",\"\"] %}\n          {% if loop.index0 % 2 == 0 %}<tr>{% endif %}\n            <td class=\"label\"><b>{{ _(field.label) }}</b></td>\n            <td>{% if value|string|lower in [\"male\",\"female\"] %}{{ _(value) }}{% else %}{{ value }}{% endif %}</td>\n          {% if loop.index0 % 2 == 1 %}</tr>{% endif %}\n        {% endif %}\n      {% endfor %}\n      {% if fields|length % 2 == 1 %}<td></td><td></td></tr>{% endif %}\n    </tbody>\n  </table>\n</div>\n",
